# Normalize text artifacts to LF in repository and working tree.
# Overrides system-level core.autocrlf for matched patterns, so LICENSE and the
# bundled probe YAML ship byte-identical from a Windows checkout.
*           text=auto eol=lf

*.md        text eol=lf
*.py        text eol=lf
*.json      text eol=lf
*.yml       text eol=lf
*.yaml      text eol=lf
*.toml      text eol=lf
.gitignore  text eol=lf
